{
  "type": "object",
  "properties": {
    "batch": {
      "const": "04"
    },
    "policy": {
      "type": "string",
      "minLength": 1
    },
    "posters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artworkId": {
            "type": [
              "string",
              "null"
            ]
          },
          "originalUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "sourceUrl": {
            "type": "string",
            "minLength": 1
          },
          "bibliographicStatus": {
            "enum": [
              "known-poster",
              "no-registered-poster"
            ]
          },
          "rights": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "not-established",
                  "allowed",
                  "denied"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "status",
              "evidence"
            ],
            "additionalProperties": false
          },
          "availability": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "not-currently-assessed",
                  "referrer-dependent-refusal",
                  "available",
                  "unavailable"
                ]
              },
              "evidence": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "observedAt": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "status",
              "evidence",
              "observedAt"
            ],
            "additionalProperties": false
          },
          "delivery": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "blocked-pending-rights",
                  "no-registered-poster",
                  "approved",
                  "unavailable"
                ]
              },
              "reliable": {
                "type": "boolean"
              }
            },
            "required": [
              "status",
              "reliable"
            ],
            "additionalProperties": false
          },
          "approvedLocalAsset": {
            "type": [
              "string",
              "null"
            ]
          },
          "fallback": {
            "const": "placeholder"
          },
          "displayAllowed": {
            "type": "boolean"
          },
          "adaptationId": {
            "type": "string",
            "pattern": "^adp:[0-9]{6}$"
          },
          "legacyId": {
            "type": "string",
            "minLength": 1
          },
          "historicalReview": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "candidateId": {
                    "type": "string"
                  },
                  "checked": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "candidateId",
                  "checked",
                  "sha256"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "artworkId",
          "originalUrl",
          "sourceUrl",
          "bibliographicStatus",
          "rights",
          "availability",
          "delivery",
          "approvedLocalAsset",
          "fallback",
          "displayAllowed",
          "adaptationId",
          "legacyId",
          "historicalReview"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "batch",
    "policy",
    "posters"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
